# Copy file này thành .env ở root repo. Dùng chung cho client/ và server/.

# --- server ---
# Cổng Express lắng nghe
PORT=3001
# Origin được phép gọi API (CORS)
CORS_ORIGIN=http://localhost:5173

# --- client (Vite dev server) ---
# Đích proxy cho /api (phải trùng PORT của server). Bỏ trống thì dùng http://localhost:3001.
# Client KHÔNG đọc PORT: nhiều công cụ đặt PORT cho chính dev server, làm proxy gọi vòng vào Vite.
API_PROXY_TARGET=http://localhost:3001

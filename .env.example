# Copy file này thành .env ở root repo. Dùng chung cho client/ và server/.

# --- server ---
# Cổng Express lắng nghe
PORT=3001
# Origin được phép gọi API (CORS)
CORS_ORIGIN=http://localhost:5173

# --- client (Vite dev server) ---
# Đích proxy cho /api. Bỏ trống thì dùng http://localhost:$PORT
API_PROXY_TARGET=http://localhost:3001
